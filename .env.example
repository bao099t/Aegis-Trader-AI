# --------------------------------------------------------------------------
# AEGIS ZENITH HYBRID - ENVIRONMENT CONFIGURATION
# --------------------------------------------------------------------------

# --- 1. Notification & Connectivity ---
# Discord Webhook (Required for Live Alerts)
# How to get: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=your_webhook_url_here

# --- 2. Exchange API (Binance / Bybit) ---
# Choose your primary exchange (default: binance)
EXCHANGE_ID=binance
# API Credentials (Required for Live Execution - Keep Secret!)
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
# Simulation Mode (True = Paper Trading, False = Real Money)
SIMULATION_MODE=True

# --- 3. Risk Management ---
# Maximum Capital per Trade (Percentage)
MAX_POSITION_SIZE=0.30
# Global Stop Loss (Default 3.5x ATR)
STOP_LOSS_MULTIPLIER=3.5
# Leverage (For Futures/Turbo Mode - Use with Caution)
LEVERAGE=1

# --- 4. Advanced AI Configuration ---
# Neural Model Path (Pre-trained Zenith Model)
MODEL_PATH=data/models/neural_predictor.pt
# Minimum Confidence Score to Execute (0.0 - 1.0)
MIN_CONFIDENCE=0.75
